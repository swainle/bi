# 明策BI · 后端环境变量示例
# 复制为 .env 后按需修改

# ── 应用 ──
DEBUG=true
# 生产环境必须设置（>=32 字符），否则启动即报错
# JWT_SECRET=

# ── 数据库（PostgreSQL 14+，需要 jsonb / 物化视图）──
DATABASE_URL=postgresql://mingzebi:mingzebi@127.0.0.1:5432/mingzebi

# ── 默认管理员（首次初始化时创建，之后修改无效）──
ADMIN_USERNAME=admin
ADMIN_PASSWORD=
ADMIN_EMAIL=admin@mingzebi.local

# ── LLM（AI 生成看板 / 自然语言转 SQL）──
LLM_API_BASE=https://api.deepseek.com
LLM_API_KEY=
LLM_MODEL=deepseek-chat

# ── 可选：Redis（布局缓存 / 分布式限流）──
REDIS_URL=

# ── 可选：Doris（大表加速，不配置则全部走 PostgreSQL）──
DORIS_HOST=
DORIS_PORT=9030
DORIS_DB=mingzebi

# ── 可选：错误上报（Sentry / 自建 GlitchTip）──
# 留空 = 不启用（只记站内 bi_error_log）；填 DSN 后自动上报 FastAPI / SQLAlchemy 错误
SENTRY_DSN=
SENTRY_ENVIRONMENT=production
# 性能采样率，0 = 只收错误
SENTRY_TRACES_SAMPLE_RATE=0
