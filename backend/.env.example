# 明策BI · 后端环境变量示例
# 复制为 .env 后按需修改

# ── 应用 ──
DEBUG=true
# 生产环境必须设置（>=32 字符），否则启动即报错
# JWT_SECRET=

# ── 数据库（PostgreSQL 14+，需要 jsonb / 物化视图）──
DATABASE_URL=postgresql://mingzebi:mingzebi@127.0.0.1:5432/mingzebi

# ── 默认管理员（首次初始化时创建，之后修改无效）──
ADMIN_USERNAME=admin
ADMIN_PASSWORD=
ADMIN_EMAIL=admin@mingzebi.local

# ── LLM（AI 生成看板 / 自然语言转 SQL）──
LLM_API_BASE=https://api.deepseek.com
LLM_API_KEY=
LLM_MODEL=deepseek-chat

# ── 可选：Redis（布局缓存 / 分布式限流）──
REDIS_URL=

# ── 可选：Doris（大表加速，不配置则全部走 PostgreSQL）──
DORIS_HOST=
DORIS_PORT=9030
DORIS_DB=mingzebi
